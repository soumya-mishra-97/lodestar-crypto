# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Everything is optional for a local demo: with no keys, `make up` runs in demo mode.
# Lists/maps use JSON syntax, e.g. LS_CORS_ORIGINS='["http://localhost:5173"]'

LS_ENV=local                       # local | test | staging | production
LS_LOG_LEVEL=INFO

# --- datastores (docker-compose overrides these for containers)
LS_DATABASE_URL=postgresql+asyncpg://lodestar:lodestar@localhost:5432/lodestar
LS_REDIS_URL=redis://:lodestar@localhost:6379/0
# LS_CELERY_BROKER_URL=            # defaults to LS_REDIS_URL
POSTGRES_PASSWORD=lodestar
REDIS_PASSWORD=lodestar

# --- access
# local: single user, no login; only for a stack bound to localhost (compose binds 127.0.0.1).
# password: owner account + JWT. Required when LS_ENV is staging/production.
LS_AUTH_MODE=local
# python -c "import secrets; print(secrets.token_urlsafe(48))"   (or: make secrets)
LS_JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated; first key encrypts, all keys decrypt (rotation). Needed to save holding notes.
LS_FIELD_ENCRYPTION_KEYS=
LS_ALLOW_REGISTRATION=false
LS_CORS_ORIGINS=["http://localhost:5173"]

# --- data
# auto: live when LS_COINGECKO_API_KEY is set, otherwise demo (synthetic data + "demo data" banner).
LS_DATA_MODE=auto                  # auto | demo | live
LS_COINGECKO_PLAN=public           # public | demo | pro  (a free demo key adds order-book depth and rate limit)
LS_COINGECKO_API_KEY=
# Public JSON-RPC endpoints for read-only wallet import (Bitcoin uses mempool.space).
# LS_RPC_URLS={"ethereum":"https://ethereum-rpc.publicnode.com","polygon":"https://polygon-bor-rpc.publicnode.com"}

# --- agents (optional: without a key, analysts use scripted tool plans and the template writer)
ANTHROPIC_API_KEY=
LS_LLM_ENABLED=true
LS_LLM_MODEL=claude-opus-5-5
LS_LLM_EFFORT=medium               # low | medium | high | xhigh | max
LS_LLM_SERVER_FALLBACKS=true

# --- pipeline
LS_MAX_AGENT_STEPS=6               # ReAct step limit per analyst (2-12)
LS_MAX_REPAIRS=2                   # verifier repair loops before failing closed (0-2)
LS_MISMATCH_TOLERANCE_PCT=1.5      # default; each user can change it in Settings
LS_DEMO_STEP_DELAY_MS=350          # demo only: pace steps so the live timeline is watchable
LS_DAILY_REPORT_HOUR_UTC=6

# --- rate limits
LS_RATE_LIMIT_PER_MINUTE=120
LS_LOGIN_ATTEMPTS_PER_MINUTE=5
LS_ANALYSES_PER_HOUR=30
